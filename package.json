{
  "name": "guided-live-velocity",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted web UI that increases development speed with agentic coding",
  "bin": {
    "glv-goose": "bin/glv-goose.mjs",
    "glv-claude": "bin/glv-claude.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "build": "npm-run-all build:typecheck build:assets",
    "build:typecheck": "tsc",
    "build:assets": "npm-run-all build:assets:goose build:assets:claude",
    "build:assets:goose": "tsx src/goose/build.ts",
    "build:assets:claude": "tsx src/claude/build.ts",
    "format": "ts-canon format",
    "lint": "npm-run-all lint:canon lint:mirrored lint:cross-tree",
    "lint:canon": "ts-canon lint",
    "lint:mirrored": "tsx scripts/mirrored-files.mts",
    "lint:cross-tree": "tsx scripts/cross-tree-duplicates.mts",
    "test": "npm-run-all build:assets test:vitest",
    "test:vitest": "tsx scripts/vitest-coverage.mts run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/humanize-duration": "^3.27.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "ast-v8-to-istanbul": "^1.0.5",
    "esbuild": "^0.28.2",
    "jscpd": "^5.0.16",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "ts-canon": "^0.1.4",
    "tsx": "^4.23.12",
    "type-a-bin": "^0.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@breejs/later": "^4.2.0",
    "@github/auto-complete-element": "^3.8.0",
    "@hono/node-server": "github:SynthLuvr/node-server#dist/open-prs",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "arktype": "^2.2.3",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "croner": "^10.0.1",
    "dompurify": "^3.4.14",
    "execa": "^10.0.1",
    "hono": "github:SynthLuvr/hono#dist/fix/sse-lifecycle-3765",
    "htmx.org": "2.0.10",
    "humanize-duration": "^3.34.1",
    "jsdom": "^30.0.1",
    "marked": "^18.0.10",
    "p-queue": "^9.3.3",
    "pretty-ms": "^9.3.1",
    "ts-handling": "^0.2.6",
    "which": "^7.0.0",
    "yaml": "^2.9.0"
  }
}
