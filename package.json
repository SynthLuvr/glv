{
  "name": "guided-live-velocity",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted web UI that increases development speed with agentic coding",
  "type": "module",
  "imports": {
    "#jsx": "./src/jsx/index.ts",
    "#jsx/jsx-runtime": "./src/jsx/jsx-runtime.ts"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "build": "tsc && pnpm build:assets",
    "build:assets": "tsx src/build.ts",
    "format:arrows": "pnpm convert-to-arrow .",
    "format:biome": "pnpm biome format --write .",
    "format:braces": "pnpm strip-braces .",
    "format:check": "pnpm biome check --write .",
    "format": "npm-run-all format:arrows format:braces format:biome format:check format:md",
    "lint:biome": "pnpm biome check .",
    "lint:oxlint": "pnpm oxlint --deny-warnings .",
    "lint": "npm-run-all lint:biome lint:oxlint lint:exports lint:functions lint:file-comment lint:md lint:peer-deps lint:audit lint:duplicates",
    "lint:audit": "pnpm audit --prod",
    "lint:duplicates": "pnpm exec jscpd src --format typescript --min-lines 3 --threshold 5",
    "strip-braces": "pnpm exec ast-grep scan --rule .ast-grep/rules/strip-braces.yml -U",
    "lint:exports": "pnpm exec ast-grep scan --rule .ast-grep/rules/no-inline-export.yml --error=no-inline-export --globs '!**/*.d.ts' .",
    "lint:functions": "pnpm exec ast-grep scan --rule .ast-grep/rules/no-function-declaration.yml --error=no-function-declaration --globs '!**/*.d.ts' .",
    "lint:file-comment": "pnpm exec ast-grep scan --rule .ast-grep/rules/no-file-comment.yml --error=no-file-comment --globs '!**/*.d.ts' .",
    "lint:md": "tsx scripts/pandoc-md.mts --check",
    "lint:peer-deps": "tsx scripts/peer-deps.mts",
    "format:md": "tsx scripts/pandoc-md.mts --write",
    "test": "pnpm build:assets && vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.1",
    "@ast-grep/cli-linux-x64-gnu": "^0.45.1",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "convert-to-arrow": "^1.1.4",
    "esbuild": "^0.28.1",
    "jscpd": "^5.0.14",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "type-a-bin": "github:SynthLuvr/type-a-bin#dist",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@kitajs/html": "^4.2.13",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/cookie": "^1.0.0",
    "arktype": "^2.2.3",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "cookie": "^1.1.1",
    "dompurify": "^3.4.13",
    "elysia": "^1.4.29",
    "execa": "^10.0.1",
    "htmx.org": "2.0.10",
    "jsdom": "^30.0.1",
    "marked": "^18.0.9",
    "p-queue": "^9.3.3"
  }
}
