{
  "name": "guided-live-velocity",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted web UI that increases development speed with agentic coding",
  "bin": {
    "glv": "bin/glv.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "build": "npm-run-all build:typecheck build:assets",
    "build:typecheck": "tsc",
    "build:assets": "npm-run-all build:assets:glv build:assets:goose build:assets:claude",
    "build:assets:goose": "tsx src/goose/build.ts",
    "build:assets:claude": "tsx src/claude/build.ts",
    "build:assets:glv": "tsx src/glv/build-product.ts",
    "format": "ts-canon format",
    "lint": "npm-run-all lint:canon lint:mirrored lint:cross-tree",
    "lint:canon": "ts-canon lint",
    "shots": "npm-run-all build:assets shots:capture",
    "shots:capture": "tsx scripts/shots.mts",
    "lint:mirrored": "tsx scripts/mirrored-files.mts",
    "lint:cross-tree": "tsx scripts/cross-tree-duplicates.mts",
    "test": "npm-run-all build:assets test:vitest",
    "test:vitest": "tsx scripts/vitest-coverage.mts run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/humanize-duration": "^3.27.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ast-v8-to-istanbul": "^1.0.7",
    "esbuild": "^0.28.2",
    "jscpd": "^5.4.1",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "ts-canon": "^0.2.1",
    "tsx": "^4.23.15",
    "type-a-bin": "^0.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@breejs/later": "^4.2.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/sse": "^0.6.1",
    "@github/auto-complete-element": "^3.8.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "arktype": "^2.2.8",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "croner": "github:SynthLuvr/croner#e6ebadbf63113f055445b23f4cd51b2e7821ad83",
    "cronstrue": "^3.31.0",
    "dompurify": "^3.4.16",
    "execa": "^10.1.0",
    "fastify": "^5.12.5",
    "hono": "^4.13.13",
    "htmx.org": "2.0.11",
    "humanize-duration": "^3.35.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "p-queue": "^9.3.3",
    "pretty-ms": "^9.3.1",
    "ts-handling": "^0.2.6",
    "which": "^7.0.0",
    "yaml": "^2.9.1"
  }
}
