#!/bin/sh
# Project-relative launcher for the glv-goose CLI.
# Resolves the project root from this script's own location,
# so it works regardless of where it's invoked from.

# Resolve symlinks so the launcher works whether invoked directly or via symlink
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SYM="$(readlink "$SELF")"
  case "$SYM" in
    /*) SELF="$SYM" ;;
    *)  SELF="$DIR/$SYM" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Under Git-Bash/MSYS (the sh that runs this script on Windows), pwd
# reports /c/... mount paths that the native Windows node.exe cannot
# read; convert to the mixed C:/ form when cygpath is available. POSIX
# systems have no cygpath and keep pwd's output unchanged.
if command -v cygpath >/dev/null 2>&1; then
  PROJECT_ROOT="$(cygpath -m "$PROJECT_ROOT")"
fi

cd "$PROJECT_ROOT" || {
  echo "glv-goose: cannot cd to project root ($PROJECT_ROOT)" >&2
  exit 1
}

exec node --import "$PROJECT_ROOT/node_modules/tsx/dist/loader.mjs" "$PROJECT_ROOT/src/goose/cli.ts" "$@"
