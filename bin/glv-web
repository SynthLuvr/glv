#!/bin/sh
# Launcher for the glv web viewer — starts the local sessions browser.

SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SYM="$(readlink "$SELF")"
  case "$SYM" in
    /*) SELF="$SYM" ;;
    *)  SELF="$DIR/$SYM" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT" || {
  echo "glv-web: cannot cd to project root ($PROJECT_ROOT)" >&2
  exit 1
}

exec node --import "$PROJECT_ROOT/node_modules/tsx/dist/loader.mjs" "$PROJECT_ROOT/src/cli.ts" serve "$@"
