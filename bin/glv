#!/bin/sh
# Project-relative launcher for the glv (goose-log-viewer) CLI.
# Resolves the project root from this script's own location,
# so it works regardless of where it's invoked from.

# Resolve symlinks so the launcher works whether invoked directly or via symlink
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SYM="$(readlink "$SELF")"
  case "$SYM" in
    /*) SELF="$SYM" ;;
    *)  SELF="$DIR/$SYM" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT" || {
  echo "glv: cannot cd to project root ($PROJECT_ROOT)" >&2
  exit 1
}

exec node --import "$PROJECT_ROOT/node_modules/tsx/dist/loader.mjs" "$PROJECT_ROOT/src/cli.ts" "$@"
