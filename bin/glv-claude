#!/bin/sh
# Project-relative launcher for the glv-claude CLI (claude sessions).
# Resolves the project root from this script's own location,
# so it works regardless of where it's invoked from.

# Resolve symlinks so the launcher works whether invoked directly or via symlink
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SYM="$(readlink "$SELF")"
  case "$SYM" in
    /*) SELF="$SYM" ;;
    *)  SELF="$DIR/$SYM" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Under Git-Bash/MSYS (the sh that runs this script on Windows), pwd
# reports /d/... mount paths that the native Windows node.exe cannot
# read. pwd -W prints the Windows mixed form (D:/...) and exists only
# in MSYS shells, so this is a no-op on POSIX systems.
WIN_ROOT="$(cd "$PROJECT_ROOT" && pwd -W 2>/dev/null || true)"
[ -n "$WIN_ROOT" ] && PROJECT_ROOT="$WIN_ROOT"

cd "$PROJECT_ROOT" || {
  echo "glv-claude: cannot cd to project root ($PROJECT_ROOT)" >&2
  exit 1
}

exec node --import "$PROJECT_ROOT/node_modules/tsx/dist/loader.mjs" "$PROJECT_ROOT/src/claude/cli.ts" "$@"
